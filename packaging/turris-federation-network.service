[Unit]
Description=Turris Federation notebook network guard
After=network-online.target NetworkManager.service zerotier-one.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/lib/turris-federation/notebook_network_service.py serve
Restart=on-failure
RestartSec=2
RuntimeDirectory=turris-federation
RuntimeDirectoryMode=0755
StateDirectory=turris-federation-notebook-network
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_DAC_READ_SEARCH
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
