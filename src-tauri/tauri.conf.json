{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Turris Federation",
  "version": "0.1.0",
  "identifier": "cz.turris.federation",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "title": "Turris Federation", "width": 1280, "height": 820, "minWidth": 860, "minHeight": 600 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false }
}

